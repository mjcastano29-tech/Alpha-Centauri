# API (api/main.py) — copia a .env en el servidor; no hay secretos aquí
CORS_ORIGENES=http://localhost:5173,https://alpha-centauri.vercel.app   # orígenes del frontend, separados por coma (* en desarrollo)
MAX_EPISODIOS=50                                                         # tope de épocas por petición a POST /evaluar
COMMIT_SHA=                                                              # lo rellena la plataforma de despliegue (Render: RENDER_GIT_COMMIT); vacío = git local

# Web (web/) — las variables VITE_ se incrustan en el cliente y son públicas
VITE_API_BASE_URL=http://localhost:8000
